// Fechar a janela solta a sessão. O padrão do Zellij já é detach;
// deixar explícito evita que uma troca de padrão encerre os SSH.
on_force_close "detach"
scroll_buffer_size 100000
copy_command "wl-copy"

keybinds {
    pane {
        // Dentro de ssh-* abre outro SSH. Fora disso, abre um shell local.
        bind "n" {
            Run "ducke" "srv" "pane" {
                close_on_exit true
            }
            SwitchToMode "Normal"
        }
    }
}
